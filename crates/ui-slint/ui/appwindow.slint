// IronPlayer — UI Broadcast em Slint.
// Coluna esquerda com 4 abas (PIDs / Tabelas / Serviços / Media Info),
// vídeo + gráficos ocupando o restante, status bar no rodapé.
// Dados preenchidos pela camada Rust (src/lib.rs).

import { ListView } from "std-widgets.slint";

// Fontes embutidas (EmbedFiles no build.rs). Inter e JetBrains Mono são
// desenhadas para rasterização sem hinting — o femtovg (renderer wgpu, único
// compatível com o vídeo zero-copy) não aplica hinting, e Segoe UI/Consolas
// ficam serrilhadas nesse caminho.
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";
import "fonts/Inter-ExtraBold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Medium.ttf";
import "fonts/JetBrainsMono-SemiBold.ttf";
import "fonts/JetBrainsMono-Bold.ttf";
import "fonts/JetBrainsMono-ExtraBold.ttf";

// ─── Tema ───────────────────────────────────────────────────────────────────
// Mora em theme.slint para que probe.slint também o use sem ciclo de import.
import { Theme } from "theme.slint";
export { Theme }

// ─── Modo Probe (SPEC-PROBE-018/019/021/022/023/025) ────────────────────────
import {
    ProbeMosaic, ProbeFeedView, ProbeServiceView, ProbeAlerts,
    ProbeTile, ProbeServiceTile, ProbeGridRow, ProbeGridCell, ProbeGridTick,
    ProbeEventRow, ProbeAlertRow, ProbeChart, ProbeInfoRow, ProbeHistBar
} from "probe.slint";
export {
    ProbeTile, ProbeServiceTile, ProbeGridRow, ProbeGridCell, ProbeGridTick,
    ProbeEventRow, ProbeAlertRow, ProbeChart, ProbeInfoRow
}

// ─── Structs de dados (espelhados em Rust) ──────────────────────────────────
export struct PidRow {
    pid-dec: string,
    pid-hex: string,
    kind: string,
    kind-color: color,
    label: string,
    kbps: string,
    cc: string,
    has-errors: bool,
    selected: bool,
    /// PID já visto no stream, mas ausente da janela de bitrate mais recente
    /// (não removido da lista — evita o flicker de PIDs de baixa cadência).
    ghost: bool,
    pid: int,
}

export struct InfoRow {
    key: string,
    value: string,
    accent: bool,
}

/// Nó achatado da árvore PSI/SI (aba Tabelas). A hierarquia é linearizada no
/// Rust conforme o estado de expansão; `indent` dá o nível visual.
export struct TreeRow {
    key: string,
    label: string,
    value: string,
    indent: int,
    has-children: bool,
    expanded: bool,
    is-root: bool,
    present: bool,
}

/// Linha do relatório Media Info; `header == true` marca título de seção
/// (General / Video / Audio #n).
export struct MediaRow {
    key: string,
    value: string,
    header: bool,
}

export struct ServiceRow {
    id: string,
    name: string,
    provider: string,
    running: string,
    scrambled: bool,
    selected: bool,
    service-id: int,
}

export struct MenuEntry {
    label: string,
    id: int,
    active: bool,
    enabled: bool,
}

// ─── Menu de contexto (desenhado pelo Slint, não-nativo) ────────────────────
// Moldura de menu: fundo, borda e sombra. Conteúdo via @children.
// Largura fixa; altura se adapta ao conteúdo (layout vertical natural).
component CtxFrame inherits Rectangle {
    background: Theme.panel;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-color: #00000066;
    drop-shadow-blur: 7px;
    drop-shadow-offset-y: 2px;
    @children
}

// Linha de menu (categoria ou item). `arrow` marca submenu; `checked` mostra ✓;
// `current` realça a categoria cujo submenu está aberto.
component CtxRow inherits Rectangle {
    in property <string> label;
    in property <bool> checked: false;
    in property <bool> enabled: true;
    in property <bool> arrow: false;
    in property <bool> current: false;
    callback entered();
    callback chosen();
    height: 28px;
    border-radius: 4px;
    background: transparent;
    // TouchArea ENVOLVE o conteúdo (padrão do MenuItemBase do Slint) → hover/clique
    // captados em toda a linha.
    ta := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        changed has-hover => {
            if (root.enabled && ta.has-hover) { root.entered(); }
        }
        clicked => { if (root.enabled) { root.chosen(); } }
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 9px;
            spacing: 6px;
            Text {
                width: 13px;
                text: root.checked ? "✓" : "";
                color: Theme.accent;
                font-size: 12px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
            }

            Text {
                text: root.label;
                color: root.enabled ? Theme.text : Theme.text-faint;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            if root.arrow: Path {
                width: 5px;
                height: 9px;
                y: (parent.height - 9px) / 2;
                viewbox-width: 5;
                viewbox-height: 10;
                commands: "M 0 0 L 5 5 L 0 10 Z";
                fill: (root.current || ta.has-hover) ? Theme.accent : Theme.text-faint;
            }
        }
    }
    // Feedback de hover via `states` (padrão do MenuItemBase do Slint), com cor
    // de acento bem visível.
    states [
        active when root.current && root.enabled: {
            root.background: Theme.accent.with-alpha(0.22);
        }
        hovered when ta.has-hover && root.enabled: {
            root.background: Theme.accent.with-alpha(0.14);
        }
    ]
}

// ─── Badge de tipo de PID ────────────────────────────────────────────────────
component TypeBadge inherits Rectangle {
    in property <string> text;
    in property <color> tint;
    in property <bool> filled: true;
    width: txt.preferred-width + 14px;
    height: 18px;
    border-radius: 3px;
    background: filled ? tint.with-alpha(0.16) : transparent;
    border-width: 1px;
    border-color: tint.with-alpha(0.45);
    txt := Text {
        text: root.text;
        color: tint;
        font-size: 10px;
        font-weight: 700;
        font-family: Theme.mono;
        letter-spacing: 0.4px;
    }
}

// ─── Cabeçalho de coluna ordenável (tabela de PIDs) ─────────────────────────
component SortHeader inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <bool> descending;
    in property <bool> align-right: false;
    callback clicked();
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
        HorizontalLayout {
            spacing: 3px;
            alignment: root.align-right ? end : start;
            Text {
                text: root.label;
                color: root.active ? Theme.accent : (ta.has-hover ? Theme.text-dim : Theme.text-faint);
                font-size: 10px;
                font-weight: root.active ? 700 : 500;
                letter-spacing: 0.5px;
                vertical-alignment: center;
            }

            if root.active: Path {
                width: 7px;
                height: 5px;
                y: (parent.height - 5px) / 2;
                viewbox-width: 8;
                viewbox-height: 5;
                commands: root.descending ? "M 0 0 L 4 5 L 8 0 Z" : "M 0 5 L 4 0 L 8 5 Z";
                fill: Theme.accent;
            }
        }
    }
}

// ─── Cabeçalho de seção ───────────────────────────────────────────────────────
component SectionHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> trailing;
    height: 28px;
    Text {
        text: root.title;
        color: Theme.text-dim;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.2px;
        vertical-alignment: center;
    }

    Rectangle {
        horizontal-stretch: 1;
    }

    Text {
        text: root.trailing;
        color: Theme.text-faint;
        font-size: 10px;
        letter-spacing: 0.8px;
        vertical-alignment: center;
    }
}

// ─── Aba clicável ─────────────────────────────────────────────────────────────
component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    height: 28px;
    width: lbl.preferred-width;
    VerticalLayout {
        lbl := Text {
            text: root.text;
            color: root.active ? Theme.text : Theme.text-faint;
            font-size: 14px;
            font-weight: root.active ? 700 : 500;
            vertical-alignment: center;
        }

        Rectangle {
            height: 2px;
            background: root.active ? Theme.accent : transparent;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

// ─── Card de gráfico ─────────────────────────────────────────────────────────
component ChartCard inherits Rectangle {
    in property <string> title;
    in property <string> unit;
    in property <string> big-value;
    in property <string> sub-value;
    in property <string> area-commands;
    in property <string> line-commands;
    in property <color> line-color;
    in property <bool> dashed-guides: false;
    background: Theme.card;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border-soft;
    clip: true;
    // Plots (Paths) mudam a ≤4 Hz — cachear evita re-tesselação por frame.
    cache-rendering-hint: true;

    // Área do plot: borda a borda na horizontal e colada na base do card;
    // apenas a faixa do cabeçalho (título + valor) fica reservada no topo.
    Rectangle {
        x: 0;
        y: 46px;
        width: parent.width;
        height: parent.height - 46px;
        clip: true;
        if root.dashed-guides: Rectangle {
            y: parent.height / 2;
            height: 1px;
            background: Theme.border;
        }
        Path {
            width: 100%;
            height: 100%;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 100;
            viewbox-height: 100;
            commands: root.area-commands;
            fill: root.line-color.with-alpha(0.14);
        }

        Path {
            width: 100%;
            height: 100%;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 100;
            viewbox-height: 100;
            commands: root.line-commands;
            stroke: root.line-color;
            stroke-width: 1.5px;
        }
    }

    VerticalLayout {
        x: 0;
        y: 0;
        width: parent.width;
        height: 46px;
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 6px;
        spacing: 1px;
        alignment: start;
        HorizontalLayout {
            Text {
                text: root.title;
                color: Theme.text-dim;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 1px;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Text {
                text: root.unit;
                color: Theme.text-faint;
                font-size: 10px;
            }
        }

        HorizontalLayout {
            spacing: 7px;
            alignment: start;
            Text {
                text: root.big-value;
                color: root.line-color;
                font-size: 18px;
                font-weight: 800;
                font-family: Theme.mono;
            }

            Text {
                text: root.sub-value;
                color: Theme.text-dim;
                font-size: 11px;
                vertical-alignment: bottom;
            }
        }
    }
}

// ─── Linha compacta key/value (usada no card de pipeline) ───────────────────────
component InfoLineSmall inherits HorizontalLayout {
    in property <string> key;
    in property <string> value;
    in property <bool> accent: false;
    height: 17px;
    spacing: 8px;
    Text {
        text: root.key;
        color: Theme.text-dim;
        font-size: 11px;
        horizontal-stretch: 0;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        text: root.value;
        color: root.accent ? Theme.accent : Theme.text;
        font-size: 11px;
        font-family: Theme.mono;
        font-weight: root.accent ? 700 : 500;
        horizontal-stretch: 1;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }
}

// ─── Card de informações completas do pipeline (decode/hwaccel/sync) ────────────
component InfoCard inherits Rectangle {
    in property <string> title;
    in property <[InfoRow]> rows-left;
    in property <[InfoRow]> rows-mid;
    in property <[InfoRow]> rows-right;
    background: Theme.card;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border-soft;
    // Texto denso que muda a ≤4 Hz — cachear evita re-shaping por frame.
    cache-rendering-hint: true;
    VerticalLayout {
        padding: 8px;
        spacing: 2px;
        Text {
            text: root.title;
            color: Theme.text-dim;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
        }

        HorizontalLayout {
            spacing: 14px;
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 1px;
                alignment: start;
                horizontal-stretch: 1;
                for i in root.rows-left: InfoLineSmall {
                    key: i.key;
                    value: i.value;
                    accent: i.accent;
                }
            }

            VerticalLayout {
                spacing: 1px;
                alignment: start;
                horizontal-stretch: 1;
                for i in root.rows-mid: InfoLineSmall {
                    key: i.key;
                    value: i.value;
                    accent: i.accent;
                }
            }

            VerticalLayout {
                spacing: 1px;
                alignment: start;
                horizontal-stretch: 1;
                for i in root.rows-right: InfoLineSmall {
                    key: i.key;
                    value: i.value;
                    accent: i.accent;
                }
            }
        }
    }
}

// ─── Janela principal ─────────────────────────────────────────────────────────
export component AppWindow inherits Window {
    title: "IronPlayer";
    preferred-width: 1360px;
    preferred-height: 760px;
    min-width: 1100px;
    min-height: 660px;
    background: Theme.bg;
    default-font-family: Theme.sans;
    default-font-size: 14px;

    // ── Estado (preenchido pela camada Rust) ───────────────────────────────
    in-out property <string> url: "udp://@239.0.0.1:1234";
    in property <bool> connected: false;
    in property <bool> connecting: false;
    in property <string> conn-label: "Desconectado";
    in property <string> total-mbps: "—";
    in property <string> cc-total: "0";
    in property <string> buffer-pct: "0%";
    in property <string> audio-summary: "—";
    in property <string> hw-summary: "—";
    in property <bool> live: false;
    in property <string> timecode: "--:--:--:--";

    in property <image> video-frame;
    in property <bool> video-has-signal: false;
    in property <string> video-caption: "sem sinal";
    in property <string> video-res: "—";
    /// Proporção efetiva para letterboxing (DAR ou forçada pelo usuário).
    in property <float> video-display-aspect: 16.0 / 9.0;

    in property <[MenuEntry]> ctx-services: [];
    in property <[MenuEntry]> ctx-videos: [];
    in property <[MenuEntry]> ctx-audio: [];
    in property <[MenuEntry]> ctx-subtitles: [];
    in property <[MenuEntry]> ctx-aspect: [];
    in property <[MenuEntry]> ctx-deinterlace: [];
    in property <[MenuEntry]> ctx-decode: [];

    in property <[PidRow]> pid-rows: [];
    in property <string> pid-total: "—";
    in property <int> pid-count: 0;
    // Ordenação da tabela de PIDs: 0 PID · 1 KBPS · 2 CC.
    in property <int> pid-sort-col: 0;
    in property <bool> pid-sort-desc: false;

    in property <[MediaRow]> media-rows: [];
    in property <[TreeRow]> psi-tree: [];
    in property <[ServiceRow]> services: [];

    in property <string> bitrate-value: "—";
    in property <string> bitrate-sub: "";
    in property <string> bitrate-area: "";
    in property <string> bitrate-line: "";
    in property <string> jitter-value: "—";
    in property <string> jitter-sub: "";
    in property <string> jitter-line: "";
    in property <[InfoRow]> pipeline-info-left: [];
    in property <[InfoRow]> pipeline-info-mid: [];
    in property <[InfoRow]> pipeline-info-right: [];

    // Aba ativa da coluna esquerda: 0 PIDs · 1 Tabelas · 2 Serviços · 3 Media Info
    in-out property <int> active-tab: 0;

    // ── Modo da aplicação (SPEC-PROBE-001) ─────────────────────────────────
    // 0 Cinema · 1 Broadcast · 2 Probe. Espelha `ui_slint::AppMode`; o valor
    // inicial vem de `[ui] mode` do ironstream.toml.
    in-out property <int> app-mode: 1;

    // ── Estado do modo Probe (SPEC-PROBE-018/019/021/022/023) ──────────────
    in property <[ProbeTile]> probe-tiles: [];
    in property <int> probe-max-feeds: 2;
    in property <string> probe-run-clock: "00:00:00";
    in property <string> probe-run-id: "";
    in property <bool> probe-recording: false;
    in property <string> probe-status: "";
    /// Nível aberto: 0 feeds · 1 feed · 2 serviço (§8).
    in-out property <int> probe-level: 0;
    /// Aba do nível 1: 0 Resumo · 1 Serviços (SPEC-PROBE-022).
    in-out property <int> probe-feed-tab: 0;
    in property <ProbeTile> probe-detail-tile;
    in property <ProbeServiceTile> probe-service-tile;
    in property <[ProbeServiceTile]> probe-services: [];
    // Grade de saúde por cluster de tempo (SPEC-PROBE-023).
    in property <[ProbeGridRow]> probe-grid-rows: [];
    in property <[ProbeGridCell]> probe-grid-cells: [];
    in property <[ProbeGridTick]> probe-grid-ticks: [];
    in property <int> probe-grid-cols: 0;
    in-out property <int> probe-grid-selected-row: -1;
    in-out property <int> probe-grid-selected-col: -1;
    in property <string> probe-grid-caption: "";
    in property <[ProbeChart]> probe-charts: [];
    in property <[ProbeEventRow]> probe-events: [];
    in property <[ProbeInfoRow]> probe-summary: [];
    in property <[ProbeInfoRow]> probe-health: [];
    in property <[ProbeInfoRow]> probe-streams: [];
    // Aba `Rede` do nível 1 — toda a camada IP (SPEC-PROBE-IP-047).
    in property <[ProbeInfoRow]> probe-net-input: [];
    in property <[ProbeInfoRow]> probe-net-rtp: [];
    in property <[ProbeInfoRow]> probe-net-fec: [];
    in property <[ProbeHistBar]> probe-net-histogram: [];
    in property <string> probe-net-histogram-caption: "";
    in property <bool> probe-net-rtp-applicable: true;
    in property <bool> probe-net-fec-applicable: true;
    in property <string> probe-net-rtp-hint: "";
    in property <string> probe-net-fec-hint: "";
    in property <string> probe-net-help: "";
    in-out property <int> probe-window-index: 1;
    in property <string> probe-severity-filter: "todas";
    // Nível 3: alertas consolidados da célula selecionada (SPEC-PROBE-025).
    in-out property <bool> probe-alerts-open: false;
    in property <[ProbeAlertRow]> probe-alerts: [];
    in property <string> probe-alerts-title: "";
    in property <string> probe-alerts-subtitle: "";

    // ── Callbacks (tratados em Rust) ───────────────────────────────────────
    callback connect(string);
    callback disconnect();
    callback select-pid(int);
    /// Clique num cabeçalho de coluna da tabela de PIDs (0 PID · 1 KBPS · 2 CC).
    callback set-pid-sort(int);
    /// Texto do filtro da tabela de PIDs mudou.
    callback pid-filter-changed(string);
    /// Expande/colapsa um nó da árvore PSI/SI (aba Tabelas).
    callback toggle-node(string);
    callback select-service(int);
    callback select-video(int);
    callback select-audio(int);
    callback set-aspect-ratio(int);
    callback set-deinterlace(int);
    callback set-hwaccel(int);
    /// Troca de modo pelo seletor triplo (0 Cinema · 1 Broadcast · 2 Probe).
    ///
    /// SPEC-PROBE-001
    callback set-mode(int);
    /// Abre/fecha o run de monitoração (SPEC-PROBE-004).
    callback probe-start-run();
    callback probe-stop-run();
    /// Gera o relatório HTML do run (SPEC-PROBE-014).
    callback probe-export-report();
    /// Abre o nível 1 de um feed (SPEC-PROBE-019).
    callback probe-open-feed(int);
    /// Abre o nível 2 de um serviço (SPEC-PROBE-022).
    callback probe-open-service(int);
    /// Sobe um nível; `probe-back(true)` volta direto para os feeds.
    callback probe-back(bool);
    /// Troca a aba do nível 1 (0 Resumo · 1 Serviços).
    callback probe-set-feed-tab(int);
    /// Clique numa célula da grade de saúde: linha, coluna (SPEC-PROBE-023).
    callback probe-grid-cell-clicked(int, int);
    /// Fecha a lista de alertas da janela (SPEC-PROBE-025).
    callback probe-close-alerts();
    /// Troca a janela dos gráficos (SPEC-PROBE-010).
    callback probe-select-window(int);
    /// Alterna o filtro de severidade do event log (§8.2).
    callback probe-cycle-severity();

    // ── Estado do menu de contexto (interno) ───────────────────────────────
    // Posição do clique direito (relativa à janela).
    property <length> ctx-x: 0px;
    property <length> ctx-y: 0px;
    // Seção do submenu aberto: -1 nenhum · 0 Serviço · 1 Vídeo · 2 Áudio ·
    // 3 Legenda · 4 Proporção · 5 Deinterlace · 6 Decodificação.
    property <int> ctx-section: -1;
    // Topo do submenu, alinhado à categoria sob o cursor (coord. do popup raiz).
    property <length> ctx-sub-y: 0px;
    // Itens do submenu da seção ativa (modelos vindos do Rust).
    property <[MenuEntry]> ctx-sub-entries:
        root.ctx-section == 1 ? root.ctx-videos :
        root.ctx-section == 2 ? root.ctx-audio :
        root.ctx-section == 3 ? root.ctx-subtitles :
        root.ctx-section == 4 ? root.ctx-aspect :
        root.ctx-section == 5 ? root.ctx-deinterlace :
        root.ctx-section == 6 ? root.ctx-decode :
        root.ctx-services;

    // Fecha o menu de forma diferida após escolher um item — evita re-entrar no
    // event do TouchArea do item (que geraria panic, igual ao menu fluent do Slint).
    ctx-close-timer := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            ctx-menu.close();
            root.ctx-section = -1;
        }
    }

    // Menu de contexto desenhado pelo Slint (PopupWindow → mesmo event loop, NÃO
    // usa ContextMenuArea, que no Windows abre o menu nativo muda/TrackPopupMenu
    // modal e congela o vídeo). É UM ÚNICO popup: coluna de categorias + submenu
    // flutuante interno (mesmo espaço de coordenadas → hover/clique confiáveis).
    // PopupWindow no winit é child-window embarcado e redimensiona reativamente,
    // então a área cresce/encolhe conforme a seção (altura adaptativa).
    ctx-menu := PopupWindow {
        x: root.ctx-x;
        y: root.ctx-y;
        close-policy: close-on-click-outside;

        // min-width/min-height (abaixo) são obrigatórios: o runtime do Slint resolve
        // o hit-test do PopupWindow (item_geometry via layout_info().min, não
        // .preferred) de forma reativa a cada mudança de propriedade. O PopupWindow
        // em si não tem width/height explícitos — só o Rectangle filho tem — então,
        // sem um min casando o tamanho real, layout_info().min cai para 0 assim que a
        // primeira reavaliação roda (quase imediatamente após show()), colapsando a
        // área de hit-test para 0x0 mesmo com o conteúdo continuando a ser desenhado
        // no tamanho certo (o Rectangle filho tem width/height próprios). Resultado:
        // o menu aparece normalmente, mas nenhuma posição do mouse — nem hover nem
        // clique fora — nunca mais é considerada "dentro" do popup.
        min-width: container.width;
        min-height: container.height;

        // Métricas (mantêm o cálculo de tamanho coerente com o conteúdo).
        property <length> cat-w: 184px;
        property <length> sub-w: 264px;
        property <length> row-h: 28px;
        property <length> pad: 5px;
        property <length> step: self.row-h + 1px;         // linha + spacing
        property <length> sep-h: 9px;
        property <length> cat-h: self.pad * 2 + 7 * self.row-h + 2 * self.sep-h + 8 * 1px;
        property <int> sub-n: max(root.ctx-sub-entries.length, 1);
        property <length> sub-h: self.pad * 2 + self.sub-n * self.row-h + (self.sub-n - 1) * 1px;
        property <bool> sub-open: root.ctx-section >= 0;

        // Contagem de itens por seção (mín. 1 p/ o placeholder "(nenhum)").
        property <int> n-service: max(root.ctx-services.length, 1);
        property <int> n-video: max(root.ctx-videos.length, 1);
        property <int> n-audio: max(root.ctx-audio.length, 1);
        property <int> n-subtitle: max(root.ctx-subtitles.length, 1);
        property <int> n-aspect: max(root.ctx-aspect.length, 1);
        property <int> n-deinterlace: max(root.ctx-deinterlace.length, 1);
        property <int> n-decode: max(root.ctx-decode.length, 1);

        pure function sub-h-of(n: int) -> length {
            return self.pad * 2 + n * self.row-h + (n - 1) * 1px;
        }

        // Alcance vertical (topo do submenu + sua altura) de cada seção. Reserva-se
        // de saída altura suficiente para a MAIOR seção possível — em vez de
        // redimensionar o container a cada troca de seção — porque o
        // redimensionamento reativo do PopupWindow roda num timer de 0ms; mudar o
        // tamanho a cada hover produzia um "pulo" visível (SPEC bug report).
        property <length> max-sub-reach: max(
            self.sub-h-of(self.n-service),
            max(self.step * 1 + self.sub-h-of(self.n-video),
            max(self.step * 2 + self.sub-h-of(self.n-audio),
            max(self.step * 3 + self.sub-h-of(self.n-subtitle),
            max(self.step * 4 + self.sep-h + 1px + self.sub-h-of(self.n-aspect),
            max(self.step * 5 + self.sep-h * 2 + 2px + self.sub-h-of(self.n-deinterlace),
                self.step * 6 + self.sep-h * 2 + 2px + self.sub-h-of(self.n-decode)))))));

        // Contêiner: largura/altura fixas desde o primeiro frame (reservam espaço
        // para o submenu mais largo/alto possível) — o popup nunca precisa
        // redimensionar depois de show(), só a caixa do submenu aparece/some via
        // `if ctx-menu.sub-open`.
        container := Rectangle {
            width: ctx-menu.cat-w - 4px + ctx-menu.sub-w;
            height: max(ctx-menu.cat-h, ctx-menu.max-sub-reach);

            // ── Coluna de categorias ──────────────────────────────────────
            CtxFrame {
                x: 0;
                y: 0;
                width: ctx-menu.cat-w;
                height: ctx-menu.cat-h;
                VerticalLayout {
                    padding: ctx-menu.pad;
                    spacing: 1px;
                    CtxRow {
                        label: "Serviço";
                        arrow: true;
                        current: root.ctx-section == 0;
                        entered => { root.ctx-section = 0; root.ctx-sub-y = 0px; }
                        chosen => { root.ctx-section = 0; root.ctx-sub-y = 0px; }
                    }

                    CtxRow {
                        label: "Vídeo";
                        arrow: true;
                        current: root.ctx-section == 1;
                        entered => { root.ctx-section = 1; root.ctx-sub-y = ctx-menu.step * 1; }
                        chosen => { root.ctx-section = 1; root.ctx-sub-y = ctx-menu.step * 1; }
                    }

                    CtxRow {
                        label: "Áudio";
                        arrow: true;
                        current: root.ctx-section == 2;
                        entered => { root.ctx-section = 2; root.ctx-sub-y = ctx-menu.step * 2; }
                        chosen => { root.ctx-section = 2; root.ctx-sub-y = ctx-menu.step * 2; }
                    }

                    CtxRow {
                        label: "Legenda";
                        arrow: true;
                        current: root.ctx-section == 3;
                        entered => { root.ctx-section = 3; root.ctx-sub-y = ctx-menu.step * 3; }
                        chosen => { root.ctx-section = 3; root.ctx-sub-y = ctx-menu.step * 3; }
                    }

                    Rectangle {
                        height: ctx-menu.sep-h;
                        Rectangle {
                            y: 4px;
                            height: 1px;
                            background: Theme.border-soft;
                        }
                    }

                    CtxRow {
                        label: "Proporção";
                        arrow: true;
                        current: root.ctx-section == 4;
                        entered => { root.ctx-section = 4; root.ctx-sub-y = ctx-menu.step * 4 + ctx-menu.sep-h + 1px; }
                        chosen => { root.ctx-section = 4; root.ctx-sub-y = ctx-menu.step * 4 + ctx-menu.sep-h + 1px; }
                    }

                    Rectangle {
                        height: ctx-menu.sep-h;
                        Rectangle {
                            y: 4px;
                            height: 1px;
                            background: Theme.border-soft;
                        }
                    }

                    CtxRow {
                        label: "Deinterlace";
                        arrow: true;
                        current: root.ctx-section == 5;
                        entered => { root.ctx-section = 5; root.ctx-sub-y = ctx-menu.step * 5 + ctx-menu.sep-h * 2 + 2px; }
                        chosen => { root.ctx-section = 5; root.ctx-sub-y = ctx-menu.step * 5 + ctx-menu.sep-h * 2 + 2px; }
                    }

                    CtxRow {
                        label: "Decodificação";
                        arrow: true;
                        current: root.ctx-section == 6;
                        entered => { root.ctx-section = 6; root.ctx-sub-y = ctx-menu.step * 6 + ctx-menu.sep-h * 2 + 2px; }
                        chosen => { root.ctx-section = 6; root.ctx-sub-y = ctx-menu.step * 6 + ctx-menu.sep-h * 2 + 2px; }
                    }
                }
            }

            // ── Submenu flutuante (à direita da categoria sob o cursor) ────
            if ctx-menu.sub-open: CtxFrame {
                x: ctx-menu.cat-w - 4px;
                y: root.ctx-sub-y;
                width: ctx-menu.sub-w;
                height: ctx-menu.sub-h;
                VerticalLayout {
                    padding: ctx-menu.pad;
                    spacing: 1px;
                    for e in root.ctx-sub-entries: CtxRow {
                        label: e.label;
                        checked: e.active;
                        enabled: e.enabled;
                        chosen => {
                            if (e.enabled) {
                                if (root.ctx-section == 0) { root.select-service(e.id); }
                                if (root.ctx-section == 1) { root.select-video(e.id); }
                                if (root.ctx-section == 2) { root.select-audio(e.id); }
                                if (root.ctx-section == 4) { root.set-aspect-ratio(e.id); }
                                if (root.ctx-section == 5) { root.set-deinterlace(e.id); }
                                if (root.ctx-section == 6) { root.set-hwaccel(e.id); }
                                ctx-close-timer.running = true;
                            }
                        }
                    }
                }
            }
        }
    }

    VerticalLayout {
        // ══ TOP BAR ══════════════════════════════════════════════════════
        Rectangle {
            height: 64px;
            background: Theme.panel;
            cache-rendering-hint: true;
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }

            HorizontalLayout {
                padding-left: 18px;
                padding-right: 16px;
                padding-top: 13px;
                padding-bottom: 13px;
                spacing: 14px;
                // Logo
                HorizontalLayout {
                    spacing: 11px;
                    alignment: start;
                    // Centralizado verticalmente com o bloco de título ao lado.
                    VerticalLayout {
                        alignment: center;
                        Path {
                            width: 18px;
                            height: 18px;
                            viewbox-width: 10;
                            viewbox-height: 10;
                            commands: "M 5 0 L 10 5 L 5 10 L 0 5 Z";
                            fill: Theme.accent;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: "IRONPLAYER";
                            color: Theme.text;
                            font-size: 17px;
                            font-weight: 800;
                            letter-spacing: 1.5px;
                        }

                        Text {
                            text: "TS · STREAM ANALYZER";
                            color: Theme.text-faint;
                            font-size: 9px;
                            letter-spacing: 1.5px;
                        }
                    }
                }

                Rectangle {
                    width: 6px;
                }

                // ── Barra de endereço ──────────────────────────────────────
                // Oculta no modo Probe: ali os feeds vêm de `[[probe.feeds]]`
                // no ironstream.toml, e um campo de URL que não conecta nada
                // seria um controle morto na tela (SPEC-PROBE-026).
                if root.app-mode == 2: Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                // Protocolo
                if root.app-mode != 2: Rectangle {
                    width: 104px;
                    background: Theme.panel-alt;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        Text {
                            text: "UDP/TS";
                            color: Theme.text-dim;
                            font-size: 13px;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }
                        // chevron ▾
                        Path {
                            width: 9px;
                            height: 6px;
                            y: (parent.height - 6px) / 2;
                            viewbox-width: 10;
                            viewbox-height: 6;
                            commands: "M 0 0 L 5 6 L 10 0 Z";
                            fill: Theme.text-faint;
                        }
                    }
                }

                // URL
                if root.app-mode != 2: Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.panel-alt;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: root.connected ? Theme.green.with-alpha(0.4) : Theme.border;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 9px;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            y: (parent.height - 8px) / 2;
                            border-radius: 4px;
                            background: root.connected ? Theme.green : (root.connecting ? Theme.accent : Theme.text-faint);
                        }

                        TextInput {
                            text <=> root.url;
                            color: Theme.text;
                            font-size: 14px;
                            font-family: Theme.mono;
                            vertical-alignment: center;
                            single-line: true;
                            horizontal-stretch: 1;
                            accepted => { root.connect(root.url); }
                        }
                    }
                }

                // Conectar
                if root.app-mode != 2: Rectangle {
                    width: 116px;
                    background: root.connected ? Theme.panel-alt : (ta-conn.has-hover ? Theme.accent.brighter(0.15) : Theme.accent);
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: root.connected ? Theme.border : Theme.accent;
                    Text {
                        text: "Conectar";
                        color: root.connected ? Theme.text-faint : #1a1206;
                        font-size: 14px;
                        font-weight: 700;
                    }

                    ta-conn := TouchArea {
                        enabled: !root.connected;
                        clicked => { root.connect(root.url); }
                    }
                }
                // Desconectar
                if root.app-mode != 2: Rectangle {
                    width: 124px;
                    background: ta-disc.has-hover && root.connected ? Theme.panel-alt.brighter(0.3) : Theme.panel-alt;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: root.connected ? Theme.red.with-alpha(0.5) : Theme.border;
                    Text {
                        text: "Desconectar";
                        color: root.connected ? Theme.text : Theme.text-faint;
                        font-size: 14px;
                        font-weight: 600;
                    }

                    ta-disc := TouchArea {
                        enabled: root.connected || root.connecting;
                        clicked => { root.disconnect(); }
                    }
                }

                Rectangle {
                    width: 4px;
                }

                // Seletor triplo Cinema · Broadcast · Probe (SPEC-PROBE-001).
                // Antes era estático: dois retângulos sem TouchArea, sem
                // callback e sem estado.
                Rectangle {
                    width: 276px;
                    background: Theme.panel-alt;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding: 4px;
                        spacing: 4px;
                        for m[i] in ["Cinema", "Broadcast", "Probe"]: Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 4px;
                            background: root.app-mode == i
                                ? Theme.accent
                                : (ta-mode.has-hover ? Theme.panel-alt.brighter(0.45) : transparent);
                            Text {
                                text: m;
                                color: root.app-mode == i ? #1a1206 : Theme.text-dim;
                                font-size: 13px;
                                font-weight: root.app-mode == i ? 700 : 400;
                            }

                            ta-mode := TouchArea {
                                clicked => { root.set-mode(i); }
                            }
                        }
                    }
                }
            }
        }

        // ══ CORPO ════════════════════════════════════════════════════════
        // Cinema e Broadcast compartilham o corpo do player; Probe substitui
        // a área inteira pelas telas de mosaico/detalhe (§3.1).
        if root.app-mode != 2: HorizontalLayout {
            padding: 12px;
            spacing: 12px;
            vertical-stretch: 1;

            // ── PAINEL ESQUERDO: abas (ocultas em Cinema, §3.1) ────────
            if root.app-mode == 1: Rectangle {
                width: 528px;
                background: Theme.panel;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border;
                // Conteúdo denso em texto que muda a ≤4 Hz: cachear a subtree
                // evita re-tesselar/re-shapear tudo a cada frame de vídeo
                // (femtovg redesenha a cena inteira por frame).
                cache-rendering-hint: true;
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    // Abas
                    HorizontalLayout {
                        spacing: 20px;
                        alignment: start;
                        TabButton {
                            text: "PIDs " + root.pid-count;
                            active: root.active-tab == 0;
                            clicked => { root.active-tab = 0; }
                        }

                        TabButton {
                            text: "Tabelas";
                            active: root.active-tab == 1;
                            clicked => { root.active-tab = 1; }
                        }

                        TabButton {
                            text: "Serviços";
                            active: root.active-tab == 2;
                            clicked => { root.active-tab = 2; }
                        }

                        TabButton {
                            text: "Media Info";
                            active: root.active-tab == 3;
                            clicked => { root.active-tab = 3; }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.border-soft;
                    }

                    // ── Conteúdo: PIDs ──────────────────────────────────
                    if root.active-tab == 0: VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 30px;
                                background: Theme.panel-alt;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: filter-input.has-focus ? Theme.accent.with-alpha(0.55) : Theme.border;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    filter-input := TextInput {
                                        color: Theme.text;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        single-line: true;
                                        horizontal-stretch: 1;
                                        edited => { root.pid-filter-changed(self.text); }
                                    }
                                }

                                if filter-input.text == "" && !filter-input.has-focus: Text {
                                    x: 10px;
                                    text: "filtrar PID, tipo ou serviço...";
                                    color: Theme.text-faint;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    height: 100%;
                                }
                            }

                            Text {
                                text: root.pid-total;
                                color: Theme.accent;
                                font-size: 13px;
                                font-weight: 700;
                                font-family: Theme.mono;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            height: 20px;
                            padding-left: 7px;
                            padding-right: 6px;
                            SortHeader {
                                width: 54px;
                                label: "PID";
                                active: root.pid-sort-col == 0;
                                descending: root.pid-sort-desc;
                                clicked => { root.set-pid-sort(0); }
                            }

                            Text {
                                text: "TIPO";
                                width: 62px;
                                color: Theme.text-faint;
                                font-size: 10px;
                                font-weight: 500;
                                letter-spacing: 0.5px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "LABEL";
                                horizontal-stretch: 1;
                                color: Theme.text-faint;
                                font-size: 10px;
                                font-weight: 500;
                                letter-spacing: 0.5px;
                                vertical-alignment: center;
                            }

                            SortHeader {
                                width: 64px;
                                label: "KBPS";
                                active: root.pid-sort-col == 1;
                                descending: root.pid-sort-desc;
                                align-right: true;
                                clicked => { root.set-pid-sort(1); }
                            }

                            SortHeader {
                                width: 44px;
                                label: "CC";
                                active: root.pid-sort-col == 2;
                                descending: root.pid-sort-desc;
                                align-right: true;
                                clicked => { root.set-pid-sort(2); }
                            }
                        }

                        ListView {
                            vertical-stretch: 1;
                            for row in root.pid-rows: Rectangle {
                                height: 38px;
                                background: row.selected ? Theme.accent.with-alpha(0.12) : (touch.has-hover ? Theme.panel-alt : transparent);
                                border-radius: 4px;
                                // Fantasma: PID já visto, ausente do snapshot de bitrate mais
                                // recente. Fica na lista (não some/pisca), só esmaecido.
                                opacity: row.ghost ? 0.45 : 1.0;
                                Rectangle {
                                    x: 0;
                                    width: 2px;
                                    background: row.selected ? Theme.accent : transparent;
                                }

                                HorizontalLayout {
                                    padding-left: 7px;
                                    padding-right: 6px;
                                    VerticalLayout {
                                        width: 54px;
                                        alignment: center;
                                        Text {
                                            text: row.pid-dec;
                                            color: row.has-errors ? Theme.red : Theme.text;
                                            font-size: 13px;
                                            font-weight: 600;
                                            font-family: Theme.mono;
                                        }

                                        Text {
                                            text: row.pid-hex;
                                            color: Theme.text-faint;
                                            font-size: 9px;
                                            font-family: Theme.mono;
                                        }
                                    }

                                    Rectangle {
                                        width: 62px;
                                        TypeBadge {
                                            x: 0;
                                            text: row.kind;
                                            tint: row.kind-color;
                                            filled: row.kind != "—" && !row.ghost;
                                        }
                                    }

                                    Text {
                                        horizontal-stretch: 1;
                                        text: row.label;
                                        color: Theme.text-dim;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    Text {
                                        width: 64px;
                                        text: row.kbps;
                                        color: Theme.text;
                                        font-size: 12px;
                                        font-family: Theme.mono;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        width: 44px;
                                        text: row.cc;
                                        color: row.has-errors ? Theme.red : Theme.text-faint;
                                        font-size: 12px;
                                        font-family: Theme.mono;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                }

                                touch := TouchArea {
                                    clicked => { root.select-pid(row.pid); }
                                }
                            }
                        }
                    }

                    // ── Conteúdo: Tabelas (árvore PSI/SI) ──────────────
                    if root.active-tab == 1: VerticalLayout {
                        spacing: 8px;
                        SectionHeader {
                            title: "TABELAS PSI / SI";
                            trailing: "clique para expandir";
                        }

                        ListView {
                            vertical-stretch: 1;
                            for node in root.psi-tree: Rectangle {
                                height: 26px;
                                background: nta.has-hover && node.has-children ? Theme.panel-alt : transparent;
                                border-radius: 4px;
                                opacity: node.is-root && !node.present ? 0.45 : 1.0;
                                nta := TouchArea {
                                    mouse-cursor: node.has-children ? MouseCursor.pointer : MouseCursor.default;
                                    clicked => {
                                        if (node.has-children) { root.toggle-node(node.key); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 6px + node.indent * 16px;
                                        padding-right: 8px;
                                        spacing: 7px;
                                        // Expansor (chevron) ou marcador de folha.
                                        Rectangle {
                                            width: 10px;
                                            if node.has-children: Path {
                                                width: 8px;
                                                height: 8px;
                                                x: 0;
                                                y: (parent.height - 8px) / 2;
                                                viewbox-width: 8;
                                                viewbox-height: 8;
                                                commands: node.expanded ? "M 0 2 L 4 7 L 8 2 Z" : "M 2 0 L 7 4 L 2 8 Z";
                                                fill: node.expanded ? Theme.accent : Theme.text-dim;
                                            }
                                            if !node.has-children && !node.is-root: Rectangle {
                                                width: 3px;
                                                height: 3px;
                                                x: 2px;
                                                y: (parent.height - 3px) / 2;
                                                border-radius: 1.5px;
                                                background: Theme.text-faint;
                                            }
                                        }

                                        Text {
                                            text: node.label;
                                            color: node.is-root ? Theme.text : Theme.text-dim;
                                            font-size: node.is-root ? 13px : 12px;
                                            font-weight: node.is-root ? 700 : 500;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: node.value;
                                            color: Theme.text-faint;
                                            font-size: 11px;
                                            font-family: Theme.mono;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }

                                        if node.is-root: Rectangle {
                                            width: 7px;
                                            height: 7px;
                                            y: (parent.height - 7px) / 2;
                                            border-radius: 3.5px;
                                            background: node.present ? Theme.green : Theme.text-faint;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ── Conteúdo: Serviços ─────────────────────────────
                    if root.active-tab == 2: VerticalLayout {
                        spacing: 8px;
                        SectionHeader {
                            title: "SERVIÇOS DVB";
                            trailing: "SDT";
                        }

                        if root.services.length == 0: Text {
                            text: "Nenhum serviço descrito (SDT) recebido.";
                            color: Theme.text-faint;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        ListView {
                            vertical-stretch: 1;
                            for svc in root.services: Rectangle {
                                height: 50px;
                                background: svc.selected ? Theme.accent.with-alpha(0.12) : (sta.has-hover ? Theme.panel-alt : transparent);
                                border-radius: 5px;
                                Rectangle {
                                    x: 0;
                                    width: 2px;
                                    background: svc.selected ? Theme.accent : transparent;
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 8px;
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: svc.name;
                                            color: Theme.text;
                                            font-size: 13px;
                                            font-weight: 600;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: svc.provider;
                                            color: Theme.text-faint;
                                            font-size: 10px;
                                            overflow: elide;
                                        }
                                    }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        Text {
                                            text: svc.id;
                                            color: Theme.text-dim;
                                            font-size: 11px;
                                            font-family: Theme.mono;
                                            horizontal-alignment: right;
                                        }

                                        Text {
                                            text: svc.scrambled ? "CA · " + svc.running : svc.running;
                                            color: svc.scrambled ? Theme.accent : Theme.green;
                                            font-size: 10px;
                                            horizontal-alignment: right;
                                        }
                                    }
                                }

                                sta := TouchArea {
                                    clicked => { root.select-service(svc.service-id); }
                                }
                            }
                        }
                    }

                    // ── Conteúdo: Media Info (relatório completo) ──────
                    if root.active-tab == 3: VerticalLayout {
                        spacing: 8px;
                        SectionHeader {
                            title: "MEDIA INFO";
                            trailing: "GENERAL · VIDEO · AUDIO";
                        }

                        if root.media-rows.length == 0: Text {
                            text: "Aguardando análise do stream...";
                            color: Theme.text-faint;
                            font-size: 12px;
                        }
                        ListView {
                            vertical-stretch: 1;
                            for r in root.media-rows: Rectangle {
                                height: r.header ? 32px : 22px;
                                if r.header: HorizontalLayout {
                                    padding-top: 10px;
                                    spacing: 8px;
                                    Text {
                                        text: r.key;
                                        color: Theme.accent;
                                        font-size: 11px;
                                        font-weight: 700;
                                        letter-spacing: 1.5px;
                                        vertical-alignment: center;
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Rectangle {
                                            height: 1px;
                                            background: Theme.border-soft;
                                        }
                                    }
                                }
                                if !r.header: HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: r.key;
                                        width: 172px;
                                        color: Theme.text-dim;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: r.value;
                                        color: Theme.text;
                                        font-size: 12px;
                                        font-family: Theme.mono;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ── CENTRO: vídeo + gráficos ────────────────────────────────
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 12px;
                Rectangle {
                    vertical-stretch: 13;
                    background: #050607;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;

                    video-shell := Rectangle {
                        width: 100%;
                        height: 100%;

                        // Letterboxing conforme proporção efetiva (DAR ou forçada).
                        property <bool> pillarbox: (parent.width / 1px) / (parent.height / 1px) > root.video-display-aspect;
                        property <length> vid-w: pillarbox ? parent.height * root.video-display-aspect : parent.width;
                        property <length> vid-h: pillarbox ? parent.height : parent.width / root.video-display-aspect;

                        if root.video-has-signal: Image {
                            x: (parent.width - vid-w) / 2;
                            y: (parent.height - vid-h) / 2;
                            width: vid-w;
                            height: vid-h;
                            source: root.video-frame;
                            image-fit: fill;
                        }
                        if !root.video-has-signal: VerticalLayout {
                            alignment: center;
                            Text {
                                text: "SINAL DE VÍDEO · " + root.video-res;
                                color: Theme.text-faint;
                                font-size: 14px;
                                letter-spacing: 2px;
                                horizontal-alignment: center;
                            }

                            Text {
                                text: root.video-caption;
                                color: #3a434d;
                                font-size: 11px;
                                letter-spacing: 1px;
                                horizontal-alignment: center;
                            }
                        }

                        // chip de codec (sup. esquerdo)
                        Rectangle {
                            x: 14px;
                            y: 14px;
                            width: cap.preferred-width + 22px;
                            height: 26px;
                            background: #0b0d10dd;
                            border-radius: 5px;
                            border-width: 1px;
                            border-color: Theme.border;
                            cap := Text {
                                text: root.video-caption;
                                color: Theme.text;
                                font-size: 12px;
                                font-family: Theme.mono;
                            }
                        }

                        // AO VIVO (sup. direito)
                        if root.live: Rectangle {
                            x: parent.width - self.width - 14px;
                            y: 14px;
                            width: 98px;
                            height: 26px;
                            background: Theme.red.with-alpha(0.16);
                            border-radius: 5px;
                            border-width: 1px;
                            border-color: Theme.red.with-alpha(0.55);
                            HorizontalLayout {
                                padding-left: 11px;
                                padding-right: 11px;
                                spacing: 7px;
                                alignment: center;
                                Rectangle {
                                    width: 7px;
                                    height: 7px;
                                    border-radius: 3.5px;
                                    y: (parent.height - 7px) / 2;
                                    background: Theme.red;
                                }

                                Text {
                                    text: "AO VIVO";
                                    color: Theme.red;
                                    font-size: 11px;
                                    font-weight: 700;
                                    letter-spacing: 0.5px;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // barra inferior: reproduzindo + timecode
                        Rectangle {
                            x: 14px;
                            y: parent.height - 40px;
                            width: parent.width - 28px;
                            height: 28px;
                            HorizontalLayout {
                                spacing: 8px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Path {
                                        width: 11px;
                                        height: 12px;
                                        y: (parent.height - 12px) / 2;
                                        viewbox-width: 10;
                                        viewbox-height: 12;
                                        commands: "M 0 0 L 10 6 L 0 12 Z";
                                        fill: root.connected ? Theme.green : Theme.text-faint;
                                    }

                                    Text {
                                        text: root.connected ? "Reproduzindo" : "Parado";
                                        color: Theme.text;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                }

                                Text {
                                    text: root.timecode;
                                    color: Theme.accent;
                                    font-size: 14px;
                                    font-weight: 700;
                                    font-family: Theme.mono;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Botão direito → menu de contexto desenhado pelo Slint.
                        // Não usa ContextMenuArea (que no Windows abre um menu nativo
                        // muda/TrackPopupMenu modal e congela o event loop/vídeo).
                        TouchArea {
                            width: 100%;
                            height: 100%;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                    root.ctx-section = -1;
                                    root.ctx-x = self.absolute-position.x + self.mouse-x;
                                    root.ctx-y = self.absolute-position.y + self.mouse-y;
                                    ctx-menu.show();
                                }
                            }
                        }
                    }
                }

                if root.app-mode == 1: HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 12px;
                    ChartCard {
                        horizontal-stretch: 1;
                        title: "BITRATE · 60 S";
                        unit: "Total";
                        big-value: root.bitrate-value;
                        sub-value: root.bitrate-sub;
                        area-commands: root.bitrate-area;
                        line-commands: root.bitrate-line;
                        line-color: Theme.green;
                    }

                    ChartCard {
                        horizontal-stretch: 1;
                        title: "PCR JITTER";
                        unit: "µs";
                        big-value: root.jitter-value;
                        sub-value: root.jitter-sub;
                        line-commands: root.jitter-line;
                        line-color: Theme.blue;
                        dashed-guides: true;
                    }

                    InfoCard {
                        horizontal-stretch: 1;
                        title: "PIPELINE";
                        rows-left: root.pipeline-info-left;
                        rows-mid: root.pipeline-info-mid;
                        rows-right: root.pipeline-info-right;
                    }
                }
            }
        }

        // ══ MODO PROBE ═══════════════════════════════════════════════════
        // Quatro níveis (§8): feeds → feed (Resumo | Serviços) → serviço →
        // alertas da janela.  O nível 3 é um overlay, montado no fim da janela.
        if root.app-mode == 2 && root.probe-level == 0: ProbeMosaic {
            vertical-stretch: 1;
            tiles: root.probe-tiles;
            max-feeds: root.probe-max-feeds;
            run-clock: root.probe-run-clock;
            run-id: root.probe-run-id;
            recording: root.probe-recording;
            status: root.probe-status;
            open-feed(slot) => { root.probe-open-feed(slot); }
            start-run => { root.probe-start-run(); }
            stop-run => { root.probe-stop-run(); }
            export-report => { root.probe-export-report(); }
        }
        if root.app-mode == 2 && root.probe-level == 1: ProbeFeedView {
            vertical-stretch: 1;
            tile: root.probe-detail-tile;
            tab: root.probe-feed-tab;
            services: root.probe-services;
            grid-rows: root.probe-grid-rows;
            grid-cells: root.probe-grid-cells;
            grid-ticks: root.probe-grid-ticks;
            grid-cols: root.probe-grid-cols;
            grid-selected-row: root.probe-grid-selected-row;
            grid-selected-col: root.probe-grid-selected-col;
            grid-caption: root.probe-grid-caption;
            charts: root.probe-charts;
            events: root.probe-events;
            summary: root.probe-summary;
            health: root.probe-health;
            net-input: root.probe-net-input;
            net-rtp: root.probe-net-rtp;
            net-fec: root.probe-net-fec;
            net-histogram: root.probe-net-histogram;
            net-histogram-caption: root.probe-net-histogram-caption;
            net-rtp-applicable: root.probe-net-rtp-applicable;
            net-fec-applicable: root.probe-net-fec-applicable;
            net-rtp-hint: root.probe-net-rtp-hint;
            net-fec-hint: root.probe-net-fec-hint;
            net-help: root.probe-net-help;
            window-index: root.probe-window-index;
            severity-filter: root.probe-severity-filter;
            back => { root.probe-back(true); }
            set-tab(i) => { root.probe-set-feed-tab(i); }
            open-service(id) => { root.probe-open-service(id); }
            grid-cell-clicked(r, c) => { root.probe-grid-cell-clicked(r, c); }
            select-window(i) => { root.probe-select-window(i); }
            cycle-severity => { root.probe-cycle-severity(); }
        }
        if root.app-mode == 2 && root.probe-level == 2: ProbeServiceView {
            vertical-stretch: 1;
            feed: root.probe-detail-tile;
            service: root.probe-service-tile;
            grid-rows: root.probe-grid-rows;
            grid-cells: root.probe-grid-cells;
            grid-ticks: root.probe-grid-ticks;
            grid-cols: root.probe-grid-cols;
            grid-selected-row: root.probe-grid-selected-row;
            grid-selected-col: root.probe-grid-selected-col;
            grid-caption: root.probe-grid-caption;
            events: root.probe-events;
            summary: root.probe-summary;
            streams: root.probe-streams;
            severity-filter: root.probe-severity-filter;
            back-to-feeds => { root.probe-back(true); }
            back-to-feed => { root.probe-back(false); }
            grid-cell-clicked(r, c) => { root.probe-grid-cell-clicked(r, c); }
            cycle-severity => { root.probe-cycle-severity(); }
        }

        // ══ STATUS BAR ═══════════════════════════════════════════════════
        Rectangle {
            height: 28px;
            background: Theme.panel;
            cache-rendering-hint: true;
            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.border;
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 18px;
                HorizontalLayout {
                    spacing: 7px;
                    alignment: start;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        y: (parent.height - 8px) / 2;
                        border-radius: 4px;
                        background: root.connected ? Theme.green : Theme.text-faint;
                    }

                    Text {
                        text: root.conn-label;
                        color: Theme.text-dim;
                        font-size: 11px;
                        font-family: Theme.mono;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                Text {
                    text: root.total-mbps + " Mbps";
                    color: Theme.text-dim;
                    font-size: 11px;
                    font-family: Theme.mono;
                    vertical-alignment: center;
                }

                Text {
                    text: "CC " + root.cc-total;
                    color: Theme.text-dim;
                    font-size: 11px;
                    font-family: Theme.mono;
                    vertical-alignment: center;
                }

                Text {
                    text: "buf " + root.buffer-pct;
                    color: Theme.text-dim;
                    font-size: 11px;
                    font-family: Theme.mono;
                    vertical-alignment: center;
                }

                Text {
                    text: root.audio-summary;
                    color: Theme.text-dim;
                    font-size: 11px;
                    font-family: Theme.mono;
                    vertical-alignment: center;
                }

                Text {
                    text: root.hw-summary;
                    color: Theme.text-faint;
                    font-size: 11px;
                    font-family: Theme.mono;
                    vertical-alignment: center;
                }
            }
        }
    }

    // ══ MODO PROBE · NÍVEL 3 ═════════════════════════════════════════════
    // Lista consolidada dos problemas de uma célula da grade.  Fica fora do
    // `VerticalLayout` do corpo, como último filho da janela, para cobrir
    // barra superior e status bar — é um modal, não mais um painel.
    //
    // SPEC-PROBE-025
    if root.app-mode == 2 && root.probe-alerts-open: ProbeAlerts {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        rows: root.probe-alerts;
        title: root.probe-alerts-title;
        subtitle: root.probe-alerts-subtitle;
        close => { root.probe-close-alerts(); }
    }
}
